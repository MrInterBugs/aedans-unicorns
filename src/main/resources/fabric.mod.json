{
  "schemaVersion": 1,
  "id": "unicorn",
  "version": "${version}",
  "name": "Aedans Unicorns",
  "description": "Adds a shiny new unicorn horn to your world to save your horses from an untimely demise.",
  "authors": [
    "MrInterBugs"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/aedans-unicorns",
    "sources": "https://github.com/mrinterbugs/unicorn/source"
  },
  "license": "MIT",
  "icon": "assets/unicorn/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "uk.mrinterbugs.unicorn.UnicornMod"
    ],
    "client": [
      "uk.mrinterbugs.unicorn.client.UnicornClientMod"
    ],
    "jei_mod_plugin": [
      "uk.mrinterbugs.unicorn.client.UnicornJeiPlugin"
    ]
  },
  "mixins": [
    "unicorn.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "recommends": {
    "jei": ">=${jei_version}"
  },
  "custom": {
    "mc-publish": {
      "dependencies": [
        "jei(recommended){modrinth:jei}",
        "fabric-api{modrinth:fabric-api}"
      ]
    }
  }
}
